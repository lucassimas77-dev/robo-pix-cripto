# ============================================================================
# CONFIGURAÇÕES GERAIS DO SERVIDOR
# ============================================================================
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ============================================================================
# ESCOLHA DO PROVEDOR PIX -> CRIPTO (FOCO EM PRIVACIDADE & AUTOCUSTÓDIA)
# Opções suportadas:
#   mock     -> Simulador completo local (testa todo o fluxo sem chaves reais)
#   depixapp -> DePix App (RECOMENDADO P/ PRIVACIDADE: Sem pedir CPF no chat,
#               cai direto na sua carteira Liquid autocustodiada, sem expor seu nome/CPF!)
#   hodle    -> Hodle (Pix -> USDT/USDC em Polygon, Base, Arbitrum, Solana - D+0)
#   noxpay   -> NoxPay CrossRamp V2 (Pix -> USDT/USDC/BTC B2B)
#   pixgo    -> PixGo (Pix -> DePix na Liquid, porém exige CPF do pagador)
# ============================================================================
CRYPTO_PROVIDER=mock

# Sua Carteira de Autocustódia (Ex: SideSwap, Aqua, Blockstream Green na Liquid ou Polygon)
WALLET_ADDRESS=lq1qq_sua_carteira_liquid_autocustodia
WALLET_ASSET=DEPIX
WALLET_NETWORK=LIQUID

# Tempo de expiração de cada chave Pix gerada (em minutos) e lembrete prévio
PIX_EXPIRATION_MINUTES=15
PIX_WARNING_BEFORE_MINUTES=3

# Pedir CPF/CNPJ no WhatsApp?
# false = ZERO identificação no chat! O cliente só fala o valor e já recebe a chave Pix na hora.
REQUIRE_PAYER_DOCUMENT=false

# ============================================================================
# CREDENCIAIS: DEPIX APP - PRIVACIDADE & SEM CPF NO CHECKOUT (https://depixapp.com)
# ============================================================================
DEPIXAPP_API_URL=https://api.depixapp.com/api
DEPIXAPP_API_KEY=
DEPIXAPP_WEBHOOK_SECRET=

# ============================================================================
# CREDENCIAIS OPCIONAIS: OUTROS PROVEDORES
# ============================================================================
HODLE_API_URL=https://api.hodle.com.br
HODLE_API_KEY=
HODLE_WEBHOOK_SECRET=

NOXPAY_API_URL=https://api.noxpay.io/v2
NOXPAY_API_KEY=
NOXPAY_WEBHOOK_SECRET=

PIXGO_API_URL=https://pixgo.org/api/v1
PIXGO_API_KEY=
PIXGO_WEBHOOK_SECRET=

# ============================================================================
# INTEGRAÇÃO WHATSAPP
#   simulator -> Simulador web local em http://localhost:3000
#   evolution -> Evolution API (WhatsApp via leitura de QR Code, sem burocracia Meta)
#   meta      -> API Oficial WhatsApp Cloud
# ============================================================================
WHATSAPP_MODE=simulator
ADMIN_WHATSAPP_PHONE=5511999999999

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=pix_crypto_bot

META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=meu_token_secreto_webhook
