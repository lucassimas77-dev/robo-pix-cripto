PORT=3000
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000

# Senha fixa opcional do painel web (se vazia, será criada na primeira abertura do painel)
ADMIN_PASSWORD=

# Provedor padrão: depixapp | hodle | noxpay | mock
CRYPTO_PROVIDER=depixapp

# DePix App (https://depixapp.com/#merchant)
DEPIXAPP_API_URL=https://api.depixapp.com/api
DEPIXAPP_API_KEY=
DEPIXAPP_WEBHOOK_SECRET=

# Hodle (opcional)
HODLE_API_URL=https://api.hodle.com.br
HODLE_API_KEY=
HODLE_WEBHOOK_SECRET=

# NoxPay (opcional)
NOXPAY_API_URL=https://api.noxpay.io/v2
NOXPAY_API_KEY=
NOXPAY_WEBHOOK_SECRET=

# Carteira para provedores que recebem endereço via API (Hodle / NoxPay)
WALLET_ADDRESS=
WALLET_ASSET=DEPIX
WALLET_NETWORK=LIQUID

PIX_EXPIRATION_MINUTES=15
PIX_WARNING_BEFORE_MINUTES=3
ADMIN_WHATSAPP_PHONE=
